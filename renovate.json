{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adamcik/renovate-config:library",
    "github>adamcik/renovate-config:automerge"
  ],
  "packageRules": [
    {
      "description": "Keep the declared minimum fixed for compatibility tests",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchPackageNames": ["/^opentelemetry-/"],
      "matchJsonata": ["managerData.depGroup = 'otel-minimum'"],
      "enabled": false
    },
    {
      "description": "Update the latest OpenTelemetry SDK and logging instrumentation together",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchPackageNames": ["/^opentelemetry-/"],
      "matchJsonata": ["managerData.depGroup = 'otel-latest'"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "OpenTelemetry latest compatibility"
    }
  ]
}
